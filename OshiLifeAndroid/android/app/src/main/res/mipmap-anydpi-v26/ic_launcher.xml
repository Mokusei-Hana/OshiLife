<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (plan §7.3). Placeholder derived from the app's
     design system — default accent #C84EF0 background, music-note motif
     from the cover placeholder — until the shared brand asset exists
     (tracked as an iOS + Android brand task). The monochrome layer enables
     Android 13+ themed icons. Legacy mipmap PNGs (API < 26) are generated
     from the same design by tool/generate_launcher_icons.dart. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
